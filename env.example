# Copie este arquivo para .env.local e preencha suas chaves de API
# O arquivo .env.local NUNCA é commitado (já está no .gitignore do Next.js)

# YouTube Data API v3 — usada para buscar vídeos de estudo
# Obtenha em: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# OpenAI API — usada para correção de redações
# Obtenha em: https://platform.openai.com/account/api-keys
# Nota: Você pode usar gpt-4.1-mini para melhor custo-benefício
OPENAI_API_KEY=sk-...
